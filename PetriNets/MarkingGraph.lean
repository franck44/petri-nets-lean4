module

public import PetriNets.Reachability
public import PetriNets.LTS.Basic

/-!
# Marking graphs as labelled transition systems

Provides the labelled transition semantics of a weighted P/T net, both over
all markings and over the markings reachable from a chosen initial marking.

The semantics has markings as states, transitions of the weighted P/T net as
labels, and `WeightedNet.Fires` as its labelled transition relation.

## Two transition systems

This module distinguishes two related notions:

* `WeightedNet.markingLTS` does not use an initial marking. Its states are all
  markings, including markings that may be unreachable.
* `WeightedNet.markingGraph net m₀` depends on an initial marking `m₀`. It is
  the part of `net.markingLTS` generated by `m₀`, so its states are exactly
  the markings reachable from `m₀`.

Both transition systems retain weighted P/T net transitions as their edge labels.

This module uses `Cslib.LTS`. Its multistep transition relation `LTS.MTr`
corresponds exactly to `WeightedNet.FiresSequence`, and its reachability
relation `LTS.CanReach` corresponds exactly to `WeightedNet.Reachable`.

## References

* W. Reisig, *Understanding Petri Nets: Modeling Techniques, Analysis Methods,
  Case Studies*, Springer, 2013, Chapter 14, especially Section 14.1,
  pp. 131–132. DOI: 10.1007/978-3-642-33278-4.
-/

@[expose] public section

namespace PetriNet

variable {P T : Type*} {net : WeightedNet P T}

/-! ## The marking LTS -/

/-- The semantics of `net` is a labelled transition system over all
markings. Transitions of the weighted P/T net are the labels of the transition
system. -/
def WeightedNet.markingLTS (net : WeightedNet P T) :
    Cslib.LTS (Marking P) T where
  Tr := net.Fires

/-- A transition of the semantics is exactly a firing of the weighted P/T net. -/
@[simp]
theorem WeightedNet.markingLTS_tr_iff (net : WeightedNet P T)
    (src : Marking P) (t : T) (tgt : Marking P) :
    net.markingLTS.Tr src t tgt ↔ net.Fires src t tgt :=
  Iff.rfl

/-- A transition is enabled at a marking exactly when the marking LTS has an
outgoing edge carrying that transition as its label. -/
theorem WeightedNet.markingLTS_enabled_iff_exists_tr
    (net : WeightedNet P T) (m : Marking P) (t : T) :
    net.Enabled m t ↔ ∃ m', net.markingLTS.Tr m t m' :=
  net.enabled_iff_exists_fires m t

/-- A multistep transition of the marking LTS is exactly a weighted P/T net firing
sequence with the same source, transition list, and target. -/
theorem WeightedNet.markingLTS_mTr_iff (net : WeightedNet P T)
    {src tgt : Marking P} {ts : List T} :
    net.markingLTS.MTr src ts tgt ↔ net.FiresSequence src ts tgt := by
  constructor
  · intro h
    induction h with
    | refl => exact WeightedNet.FiresSequence.nil _
    | stepL head _ ih => exact WeightedNet.FiresSequence.cons head ih
  · intro h
    induction h with
    | nil => exact Cslib.LTS.MTr.refl
    | cons head _ ih => exact Cslib.LTS.MTr.stepL head ih

/-- Reachability in the marking LTS is exactly weighted P/T net reachability. -/
theorem WeightedNet.markingLTS_canReach_iff
    (net : WeightedNet P T) {src tgt : Marking P} :
    net.markingLTS.CanReach src tgt ↔ net.Reachable src tgt := by
  constructor
  · rintro ⟨ts, hts⟩
    exact ⟨ts, net.markingLTS_mTr_iff.mp hts⟩
  · rintro ⟨ts, hts⟩
    exact ⟨ts, net.markingLTS_mTr_iff.mpr hts⟩

/-- A marking is dead in the weighted P/T net exactly when it is terminal in the
marking LTS. -/
theorem WeightedNet.isDead_iff_markingLTS_isTerminal
    (net : WeightedNet P T) (m : Marking P) :
    net.IsDead m ↔ net.markingLTS.IsTerminal m := by
  constructor
  · intro hterminal t m' hfires
    exact hterminal t hfires.1
  · intro hterminal t henabled
    obtain ⟨m', hfires⟩ := (net.enabled_iff_exists_fires m t).mp henabled
    exact hterminal t m' hfires

/-! ## The marking graph from an initial marking -/

/-- The marking graph of `net` from `m₀` is the labelled transition system
generated by `m₀`. Its state type consists of markings reachable from `m₀`. -/
def WeightedNet.markingGraph (net : WeightedNet P T)
    (m₀ : Marking P) :=
  net.markingLTS.generatedBy m₀

/-- The state of the marking graph representing its initial marking. The
stored reachability proof is the empty multistep transition from `m₀` to
itself. -/
def WeightedNet.markingGraphInitial (net : WeightedNet P T)
    (m₀ : Marking P) :
    {m : Marking P // net.markingLTS.CanReach m₀ m} :=
  ⟨m₀, Cslib.LTS.CanReach.refl net.markingLTS m₀⟩

/-- Every marking-graph state represents a marking reachable from the initial
marking. -/
theorem WeightedNet.markingGraph_state_reachable {m₀ : Marking P}
    (m : {m : Marking P // net.markingLTS.CanReach m₀ m}) :
    net.Reachable m₀ m.1 :=
  net.markingLTS_canReach_iff.mp m.2

/-- An edge between two marking-graph states is exactly a firing between their
markings. The reachability conditions added by `LTS.generatedBy`
are already carried by the two states. -/
theorem WeightedNet.markingGraph_tr_iff_fires {m₀ : Marking P}
    (src tgt : {m : Marking P // net.markingLTS.CanReach m₀ m}) (t : T) :
    (net.markingGraph m₀).Tr src t tgt ↔ net.Fires src.1 t tgt.1 := by
  constructor
  · unfold WeightedNet.markingGraph
    intro ⟨srcCanReach, tgtCanReach, htr⟩
    exact htr
  · intro hfires
    exact ⟨src.2, tgt.2, hfires⟩

/-- A transition is enabled at a marking-graph state exactly when that state
has an outgoing edge carrying the transition as its label. -/
theorem WeightedNet.markingGraph_enabled_iff_exists_tr {m₀ : Marking P}
    (src : {m : Marking P // net.markingLTS.CanReach m₀ m}) (t : T) :
    net.Enabled src.1 t ↔
      ∃ tgt, (net.markingGraph m₀).Tr src t tgt := by
  constructor
  · intro henabled
    obtain ⟨m', hfires⟩ := (net.enabled_iff_exists_fires src.1 t).mp henabled
    have hm'CanReach : net.markingLTS.CanReach m₀ m' :=
      src.2.stepR hfires
    let tgt : {m : Marking P // net.markingLTS.CanReach m₀ m} :=
      ⟨m', hm'CanReach⟩
    exact ⟨tgt, (net.markingGraph_tr_iff_fires src tgt t).mpr hfires⟩
  · rintro ⟨tgt, htr⟩
    exact ((net.markingGraph_tr_iff_fires src tgt t).mp htr).1

/-- A multistep transition in the marking graph is exactly a weighted P/T net firing
sequence between the markings. -/
theorem WeightedNet.markingGraph_mTr_iff {m₀ : Marking P}
    (src tgt : {m : Marking P // net.markingLTS.CanReach m₀ m})
    {ts : List T} :
    (net.markingGraph m₀).MTr src ts tgt ↔
      net.FiresSequence src.1 ts tgt.1 := by
  rw [WeightedNet.markingGraph, Cslib.LTS.generatedBy_mTr_iff]
  exact net.markingLTS_mTr_iff

/-- Reachability between two states of the marking graph is exactly weighted P/T net
reachability between their markings. -/
theorem WeightedNet.markingGraph_canReach_iff {m₀ : Marking P}
    (src tgt : {m : Marking P // net.markingLTS.CanReach m₀ m}) :
    (net.markingGraph m₀).CanReach src tgt ↔
      net.Reachable src.1 tgt.1 := by
  constructor
  · rintro ⟨ts, hmtr⟩
    exact ⟨ts, (net.markingGraph_mTr_iff src tgt).mp hmtr⟩
  · rintro ⟨ts, hseq⟩
    exact ⟨ts, (net.markingGraph_mTr_iff src tgt).mpr hseq⟩

/-- A state of the marking graph is terminal exactly when its marking is dead
in the weighted P/T net. -/
theorem WeightedNet.isDead_iff_markingGraph_isTerminal {m₀ : Marking P}
    (m : {m : Marking P // net.markingLTS.CanReach m₀ m}) :
    net.IsDead m.1 ↔ (net.markingGraph m₀).IsTerminal m := by
  constructor
  · intro hterminal t m' htr
    exact hterminal t ((net.markingGraph_enabled_iff_exists_tr m t).mpr ⟨m', htr⟩)
  · intro hterminal t henabled
    obtain ⟨m', htr⟩ := (net.markingGraph_enabled_iff_exists_tr m t).mp henabled
    exact hterminal t m' htr

end PetriNet
