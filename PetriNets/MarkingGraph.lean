module

public import PetriNets.Reachability
public import Cslib.Foundations.Semantics.LTS.Basic

/-!
# Marking graphs as labelled transition systems

The semantics of a weighted P/T net is a labelled transition system
whose states are markings, whose labels are transitions, and whose labelled
transition relation is `WeightedNet.Fires`.

The marking graph from an initial marking `m₀` is the part of this transition
system generated by `m₀`. Consequently, its states contain exactly the
markings reachable from `m₀`, while its labels retain the transitions of the
Petri net.

This module uses `Cslib.LTS`. Its multistep transition relation `LTS.MTr`
corresponds exactly to `WeightedNet.FiresSequence`, and its reachability
relation `LTS.CanReach` corresponds exactly to `WeightedNet.Reachable`.

## References

* W. Reisig, *Understanding Petri Nets: Modeling Techniques, Analysis Methods,
  Case Studies*, Springer, 2013, Chapter 14, especially Section 14.1,
  pp. 131–132. DOI: 10.1007/978-3-642-33278-4.
-/

@[expose] public section

namespace PetriNet

/-- The semantics of `net` is a labelled transition system over all
markings. Petri-net transitions are the labels of the transition system. -/
def WeightedNet.markingLTS {P T : Type*} (net : WeightedNet P T) :
    Cslib.LTS (Marking P) T where
  Tr := net.Fires

/-- A transition of the semantics of a net is exactly a firing of the Petri net. -/
@[simp]
theorem WeightedNet.markingLTS_tr_iff {P T : Type*} (net : WeightedNet P T)
    (src : Marking P) (t : T) (tgt : Marking P) :
    net.markingLTS.Tr src t tgt ↔ net.Fires src t tgt :=
  Iff.rfl

/-- A multistep transition of the marking LTS is exactly a Petri-net firing
sequence with the same source, transition list, and target. -/
theorem WeightedNet.markingLTS_mTr_iff {P T : Type*} (net : WeightedNet P T)
    {src tgt : Marking P} {ts : List T} :
    net.markingLTS.MTr src ts tgt ↔ net.FiresSequence src ts tgt := by
  constructor
  · intro h
    induction h with
    | refl => exact WeightedNet.FiresSequence.nil _
    | stepL head _ ih => exact WeightedNet.FiresSequence.cons head ih
  · intro h
    induction h with
    | nil => exact Cslib.LTS.MTr.refl
    | cons head _ ih => exact Cslib.LTS.MTr.stepL head ih

/-- Reachability in the marking LTS is exactly Petri-net reachability. -/
theorem WeightedNet.markingLTS_canReach_iff {P T : Type*}
    (net : WeightedNet P T) {src tgt : Marking P} :
    net.markingLTS.CanReach src tgt ↔ net.Reachable src tgt := by
  constructor
  · rintro ⟨ts, hts⟩
    exact ⟨ts, net.markingLTS_mTr_iff.mp hts⟩
  · rintro ⟨ts, hts⟩
    exact ⟨ts, net.markingLTS_mTr_iff.mpr hts⟩

/-- The marking graph of `net` from `m₀` is the labelled transition system
generated by `m₀`. Its state type consists of markings reachable from `m₀`. -/
def WeightedNet.markingGraph {P T : Type*} (net : WeightedNet P T)
    (m₀ : Marking P) :=
  net.markingLTS.generatedBy m₀

end PetriNet
