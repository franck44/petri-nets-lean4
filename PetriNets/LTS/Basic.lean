module

public import Cslib.Foundations.Semantics.LTS.Basic

/-!
# Additional basic LTS results

This module contains generic labelled-transition-system results used by the
Petri-net development which may eventually be contributed to CSLib.
-/

@[expose] public section

namespace Cslib.LTS.CanReach

/-- Extend reachability by one transition on the right.

TODO: this generic result should eventually move to CSLib's LTS library. -/
theorem stepR {State Label : Type*} {lts : Cslib.LTS State Label}
    {src mid tgt : State} {label : Label}
    (hreach : lts.CanReach src mid) (hstep : lts.Tr mid label tgt) :
    lts.CanReach src tgt := by
  obtain ⟨labels, hexec⟩ := hreach
  exact ⟨labels ++ [label], Cslib.LTS.MTr.stepR lts hexec hstep⟩

end Cslib.LTS.CanReach

namespace Cslib.LTS

/-- Multistep transitions in the LTS generated by `root` are exactly
multistep transitions of the original LTS between the represented states.

The reverse direction packages every intermediate state with the proof that
it is reachable from `root`.

TODO: this generic result should eventually move to CSLib's LTS library. -/
theorem generatedBy_mTr_iff {State Label : Type*}
    (lts : Cslib.LTS State Label) (root : State)
    (src tgt : {s : State // lts.CanReach root s}) {labels : List Label} :
    (lts.generatedBy root).MTr src labels tgt ↔
      lts.MTr src.1 labels tgt.1 := by
  constructor
  · intro h
    induction h with
    | refl => exact Cslib.LTS.MTr.refl
    | stepL htr _ ih => exact Cslib.LTS.MTr.stepL htr.2.2 ih
  · intro h
    have lift {a b : State} {labels : List Label}
        (hmtr : lts.MTr a labels b) :
        ∀ (ha : lts.CanReach root a) (hb : lts.CanReach root b),
          (lts.generatedBy root).MTr ⟨a, ha⟩ labels ⟨b, hb⟩ := by
      induction hmtr with
      | @refl s =>
          intro ha hb
          have heq : (⟨s, ha⟩ : {s : State // lts.CanReach root s}) =
              ⟨s, hb⟩ := Subtype.ext (by rfl)
          rw [heq]
          exact Cslib.LTS.MTr.refl
      | @stepL a label i labels b head tail ih =>
          intro ha hb
          have hi : lts.CanReach root i := ha.stepR head
          have hedge : (lts.generatedBy root).Tr ⟨a, ha⟩ label ⟨i, hi⟩ :=
            ⟨ha, hi, head⟩
          exact Cslib.LTS.MTr.stepL hedge (ih hi hb)
    exact lift h src.2 tgt.2

end Cslib.LTS
